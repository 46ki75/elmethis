{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/lib/**",
    "**/lib-types/**",
    "**/storybook-static/**",
    "**/*.log",
    "**/.DS_Store",
    "pnpm-lock.yaml",
    "**/package-lock.json",
    "**/package.json",
    ".mise/locks/**"
  ]
}
