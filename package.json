{
  "author": "Ikuma Yamashita",
  "repository": {
    "type": "git",
    "url": "git@github.com:46ki75/elmethis.git"
  },
  "homepage": "https://46ki75.github.io/elmethis",
  "scripts": {
    "check.configs": "pnpm run fmt.configs && pnpm run check.oxlint-configs",
    "check.oxlint-configs": "for file in packages/ag-ui-stub/src/index.ts packages/copilotkit/build.ts packages/core/src/index.ts packages/drawio/scripts/build-drawio-config.ts packages/ikuma-theme/scripts/index.ts packages/react/src/index.ts packages/solid/src/index.ts packages/vue/src/index.ts; do package=${file#packages/}; package=${package%%/*}; oxlint --config \"packages/$package/.oxlintrc.json\" --deny-warnings \"$file\" || exit 1; done && oxlint --deny-warnings packages/core/src/index.ts",
    "fmt.configs": "oxfmt --check .oxfmtrc.json .oxlintrc.json \"**/tsconfig*.json\" \"**/.oxlintrc.json\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "lefthook": "^2.1.14",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "pnpm": {
    "onlyBuiltDependencies": ["lefthook"],
    "overrides": {
      "@azure/msal-node@>=5.0.0-beta.0 <7.1.0": "^7.1.0",
      "@fastify/busboy@<3.2.2": "^3.2.2",
      "@hono/node-server@>=1.19.10 <2.1.3": "^2.1.3",
      "@opentelemetry/api": "1.9.0",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "dompurify@<3.4.17": "^3.4.17",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "glob@>=9.0.0 <=14.0.1": "^14.0.2",
      "graphql-scalars@>=1.24.1 <=2.0.0": "^2.0.1",
      "happy-dom@>=17.0.0 <=21.0.3": "^21.0.4",
      "minimatch@<11.0.1": "^11.0.1",
      "qs@>=6.7.0 <=6.16.0": "^6.16.1",
      "undici@<6.29.1": "^6.29.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@a2ui/markdown-it>@a2ui/web_core": "0.10"
      }
    }
  }
}
