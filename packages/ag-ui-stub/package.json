{
  "name": "@elmethis/ag-ui-stub",
  "version": "0.0.1",
  "private": true,
  "description": "Deterministic, in-process AG-UI test agent for frontend tests.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./scenarios": {
      "import": {
        "types": "./dist/scenarios.d.mts",
        "default": "./dist/scenarios.mjs"
      },
      "require": {
        "types": "./dist/scenarios.d.cts",
        "default": "./dist/scenarios.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt --write ./src",
    "fmt.check": "oxfmt --check ./src",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity=error --deny-warnings src",
    "build.types": "tsc --noEmit -p tsconfig.json",
    "test.unit": "vitest --run",
    "test.coverage": "vitest --run --coverage",
    "check": "concurrently -g \"pnpm:fmt.check\" \"pnpm:lint\" \"pnpm:build.types\"",
    "check.ci": "pnpm run check && pnpm run build && pnpm run test.coverage"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "^0.23.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
