# Optional: a Codex model available to your ChatGPT account.
# Unset uses Codex's default model.
# CODEX_MODEL=gpt-5.4

# Optional: dedicated Codex login/config directory. Use the same value at login
# and runtime. Default: ~/.local/share/elmethis/copilotkit-codex
# COPILOTKIT_CODEX_HOME=/absolute/path/to/copilotkit-codex

# No ANTHROPIC_API_KEY, OPENAI_API_KEY, or CODEX_API_KEY is needed.
# Authenticate with: mise run copilotkit:login
