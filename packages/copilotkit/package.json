{
    "name": "backend",
    "version": "1.0.0",
    "description": "CopilotKit Backend (Codex with Sign in with ChatGPT)",
    "main": "index.ts",
    "type": "module",
    "scripts": {
        "dev": "PORT=19101 node --env-file-if-exists=.env --watch ./src/server.ts",
        "prestart": "pnpm run build",
        "start": "node ./dist/index.mjs",
        "build": "node build.ts",
        "lint": "oxlint --type-aware --report-unused-disable-directives-severity=error --deny-warnings src build.ts",
        "check": "pnpm run lint && tsc --noEmit && pnpm run test.unit",
        "test.unit": "node --test src/*.spec.ts",
        "codex:login": "node src/codex-login.ts",
        "prebuild:container": "pnpm run build",
        "build:container": "docker buildx build -t copilotkit-minimal --platform linux/arm64 ."
    },
    "dependencies": {
        "@ag-ui/client": "1.0.2",
        "@ag-ui/core": "1.0.2",
        "@copilotkit/runtime": "^1.80.0",
        "@copilotkit/shared": "^1.80.0",
        "@hono/node-server": "^2.1.5",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@openai/codex": "0.163.0",
        "consola": "^3.4.2",
        "dotenv": "^18.0.9",
        "hono": "^4.13.13",
        "jose": "6.2.14",
        "rxjs": "7.8.1",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2005",
        "typescript": "^5.6.2"
    }
}
