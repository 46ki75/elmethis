{
    "name": "backend",
    "version": "1.0.0",
    "description": "CopilotKit Backend (Codex subscription)",
    "main": "index.ts",
    "type": "module",
    "scripts": {
        "dev": "PORT=19101 node --env-file-if-exists=.env --watch ./src/server.ts",
        "prestart": "pnpm run build",
        "start": "node ./dist/index.mjs",
        "build": "node build.ts",
        "lint": "eslint \"src/**/*.ts\" build.ts eslint.config.ts --max-warnings=0",
        "check": "pnpm run lint && tsc --noEmit && pnpm run test.unit",
        "test.unit": "node --test src/*.spec.ts",
        "codex:login": "node src/codex-login.ts",
        "prebuild:container": "pnpm run build",
        "build:container": "docker buildx build -t copilotkit-minimal --platform linux/arm64 ."
    },
    "dependencies": {
        "@ag-ui/client": "0.0.59",
        "@ag-ui/core": "0.0.59",
        "@copilotkit/runtime": "^1.73.1",
        "@copilotkit/shared": "^1.73.0",
        "@hono/node-server": "^2.1.1",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@openai/codex": "0.157.1",
        "rxjs": "7.8.1",
        "consola": "^3.4.2",
        "dotenv": "^18.0.1",
        "hono": "^4.13.8",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@eslint/js": "latest",
        "@types/node": "^26.5.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "jiti": "2.7.0",
        "typescript": "^5.6.2",
        "typescript-eslint": "^8.70.1"
    }
}
