{
    "name": "backend",
    "version": "1.0.0",
    "description": "CopilotKit Backend (Codex subscription)",
    "main": "index.ts",
    "type": "module",
    "scripts": {
        "dev": "PORT=19101 node --env-file-if-exists=.env --watch ./src/server.ts",
        "prestart": "pnpm run build",
        "start": "node ./dist/index.mjs",
        "build": "node build.ts",
        "lint": "oxlint --type-aware --report-unused-disable-directives-severity=error --deny-warnings src build.ts",
        "check": "pnpm run lint && tsc --noEmit && pnpm run test.unit",
        "test.unit": "node --test src/*.spec.ts",
        "codex:login": "node src/codex-login.ts",
        "prebuild:container": "pnpm run build",
        "build:container": "docker buildx build -t copilotkit-minimal --platform linux/arm64 ."
    },
    "dependencies": {
        "@ag-ui/client": "0.0.59",
        "@ag-ui/core": "0.0.59",
        "@copilotkit/runtime": "^1.73.3",
        "@copilotkit/shared": "^1.73.3",
        "@hono/node-server": "^2.1.1",
        "@modelcontextprotocol/sdk": "^1.31.0",
        "@openai/codex": "0.157.1",
        "rxjs": "7.8.1",
        "consola": "^3.4.2",
        "dotenv": "^18.0.4",
        "hono": "^4.13.9",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "esbuild": "^0.28.2",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003",
        "typescript": "^5.6.2"
    }
}
