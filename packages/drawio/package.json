{
  "name": "@elmethis/draw.io",
  "version": "0.1.7",
  "author": {
    "name": "Ikuma Yamashita",
    "url": "https://www.ikuma.cloud/"
  },
  "description": "diagrams.net configuration generated from the Elmethis design tokens.",
  "repository": {
    "type": "git",
    "url": "https://github.com/46ki75/elmethis.git",
    "directory": "packages/drawio"
  },
  "homepage": "https://github.com/46ki75/elmethis/tree/main/packages/drawio#readme",
  "bugs": {
    "url": "https://github.com/46ki75/elmethis/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/draw.io-config.json",
  "exports": {
    ".": "./dist/draw.io-config.json",
    "./draw.io-config.json": "./dist/draw.io-config.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsx scripts/build-drawio-config.ts",
    "build.types": "tsc --noEmit",
    "fmt": "prettier --write ./scripts ./README.md",
    "fmt.check": "prettier --check ./scripts ./README.md",
    "lint": "eslint \"scripts/**/*.ts\" eslint.config.ts",
    "check": "pnpm run fmt.check && pnpm run lint && pnpm run build.types && pnpm run build",
    "check.ci": "pnpm run check",
    "prepublishOnly": "pnpm run check"
  },
  "devDependencies": {
    "@elmethis/core": "workspace:^",
    "@eslint/js": "latest",
    "@types/node": "26.3.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
