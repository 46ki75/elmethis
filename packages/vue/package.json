{
  "name": "@elmethis/vue",
  "version": "0.22.1",
  "description": "Vue 3 component library for elmethis.",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "type": "module",
  "author": "Ikuma Yamashita",
  "repository": {
    "type": "git",
    "url": "git@github.com:46ki75/elmethis.git"
  },
  "homepage": "https://46ki75.github.io/elmethis",
  "main": "./lib/index.vue.mjs",
  "module": "./lib/index.vue.mjs",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": {
        "types": "./lib-types/index.d.ts",
        "default": "./lib/index.vue.mjs"
      },
      "require": {
        "types": "./lib-types/index.d.ts",
        "default": "./lib/index.vue.cjs"
      }
    },
    "./style.css": {
      "default": "./lib/style.css"
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "scripts": {
    "build": "pnpm run build.lib && pnpm run build.types",
    "build.lib": "vite build",
    "build.types": "vue-tsc --project tsconfig.lib.json",
    "build-storybook": "storybook build && node ../../scripts/verify-storybook-theme.mjs .",
    "dev": "storybook dev -p 19231 --no-open",
    "fmt": "oxfmt --write ./src",
    "fmt.check": "oxfmt --check ./src",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity=error --deny-warnings src",
    "lint.css": "stylelint \"{src,.storybook}/**/*.css\"",
    "test": "pnpm run test.unit && pnpm run test.browser",
    "test.unit": "vitest --run",
    "test.coverage": "vitest --run --coverage",
    "test.browser": "vitest --run --config vitest.browser.config.ts",
    "test.coverage.browser": "vitest --run --coverage --config vitest.browser.config.ts",
    "test.style": "node ../../scripts/verify-framework-style.mjs .",
    "test.build": "pnpm run build && pnpm run build-storybook",
    "check": "concurrently -g \"pnpm:fmt.check\" \"pnpm:lint\" \"pnpm:lint.css\" \"pnpm:build.types\"",
    "check.ci": "pnpm run check && pnpm run test.build && pnpm run test.style && pnpm run test.coverage && pnpm run test.coverage.browser",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@46ki75/ikuma-theme": "^0.0.10",
    "@a2ui/web_core": "^0.11.0",
    "@elmethis/core": "workspace:^",
    "@formkit/auto-animate": "^0.10.0",
    "@mdi/js": "^7.4.47",
    "@vueuse/core": "^15.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "es-toolkit": "^1.52.0",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "shiki": "^4.4.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.14.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "stylelint": "^17.15.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
